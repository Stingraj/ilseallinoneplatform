# ── Supabase (existing archive project) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for validated public writes (enquiries, newsletter, analytics) and viewing-room lookups.
SUPABASE_SERVICE_ROLE_KEY=

# ── Studio access ───────────────────────────────────────────────────────────────────────────────────
# Comma-separated emails allowed into /studio. Unset = nobody (the dashboard stays locked).
STUDIO_OWNER_EMAILS=

# ── Public site ─────────────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Random string; hashes visitor IPs for enquiry rate limiting (the IP itself is never stored).
ANALYTICS_SALT=
# Random string (32+ chars); signs the cookie set after a viewing-room passcode is entered.
VIEWING_ROOM_SECRET=

# ── Email / n8n ─────────────────────────────────────────────────────────────────────────────────────
# disabled (default: nothing is sent) | test (everything goes to N8N_TEST_WEBHOOK_URL) | live
EMAIL_DISPATCH_MODE=disabled
# Existing Email Studio campaign workflow. Payload unchanged: { contacts: [{ email, name }], subject, body }
N8N_CAMPAIGN_WEBHOOK_URL=
# Test workflow / request bin used in test mode for campaigns AND automations.
N8N_TEST_WEBHOOK_URL=
# Optional shared secret sent as the X-Studio-Secret header (use n8n Header Auth on the webhook nodes).
N8N_WEBHOOK_SECRET=
# New automations (separate n8n workflows; leave empty to switch one off).
N8N_ENQUIRY_WEBHOOK_URL=
N8N_WELCOME_WEBHOOK_URL=
N8N_EXHIBITION_WEBHOOK_URL=
N8N_COLLECTION_WEBHOOK_URL=
N8N_FOLLOW_UP_WEBHOOK_URL=
